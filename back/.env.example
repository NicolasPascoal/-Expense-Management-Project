# Copie este arquivo para back/.env e preencha com valores reais do seu ambiente.
# NUNCA commite o arquivo .env preenchido — ele já está (e deve continuar) no .gitignore.
# Se em algum momento um valor real deste arquivo for commitado por engano,
# trate como incidente de segurança: rotacione o segredo imediatamente (ver docs/Security.md).

# --- PostgreSQL Database Configuration ---
PGUSER=postgres
PGPASSWORD=troque-por-uma-senha-forte-gerada-aleatoriamente
PGHOST=localhost
PGPORT=5432
PGDATABASE=expense_management

# --- Security & App Settings ---
# Gere com: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=troque-por-uma-chave-aleatoria-de-64-caracteres-hex

# "True" apenas em desenvolvimento local (ativa hot-reload do Flask).
# Em produção, deixe "False" (usa Waitress/Gunicorn).
FLASK_DEBUG=False

# Lista de origens permitidas separadas por vírgula. Nunca deixe "*" em produção.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
